# CE.SDK License Key
# Request a license at https://img.ly/forms/contact-sales/
VITE_CESDK_LICENSE=YOUR_LICENSE_KEY_HERE

# ==============================================================================
# IMG.LY Gateway Configuration
# ==============================================================================
#
# The starterkit checks images and text with the `imgly/detection` model on
# the IMG.LY Gateway. Create an API key in the IMG.LY dashboard:
#   https://img.ly/dashboard
#
# Paste it below. The starterkit sends the key from the browser — this is
# fine for local development, but DO NOT ship a production build with a raw
# key baked in. Replace the dev key with a short-lived token from your
# backend when deploying.
# ==============================================================================

# API key from https://img.ly/dashboard. Leave empty when the starterkit
# is embedded in the IMG.LY showcases demo — the hosting page will
# provide a session token via postMessage instead.
VITE_AI_API_KEY=

# Optional — override the gateway URL. Defaults to https://gateway.img.ly.
# VITE_AI_GATEWAY_URL=

# Optional: where this kit's demo assets (scenes, images, fonts) are loaded
# from. Leave it unset to load them from the kit's own URL.
# VITE_DEMO_ASSETS_BASE_URL=https://your-server.example.com/assets
